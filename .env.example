# Application Environment Variables
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL with High-Concurrency Pool)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public&connection_limit=50&pool_timeout=30

# JWT Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
