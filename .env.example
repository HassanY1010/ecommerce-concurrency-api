# Application Environment Variables
PORT=3000
NODE_ENV=production
APP_URL=https://your-app-domain.up.railway.app
CORS_ORIGIN=*

# Database Connection (Supabase PostgreSQL / Cloud Hosted with Transaction Pooling)
# For Supabase Session mode: port 5432
# For Supabase Transaction mode (recommended for high concurrency): port 6543 with ?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# JWT Security
JWT_SECRET=super_strong_cryptographic_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
